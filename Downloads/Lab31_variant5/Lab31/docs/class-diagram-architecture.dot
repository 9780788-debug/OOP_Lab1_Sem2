digraph G {
rankdir=LR; nodesep=0.45; ranksep=0.7; fontname="Helvetica"; node [fontname="Helvetica"]; edge [fontname="Helvetica"];
splines=spline; bgcolor=white;
subgraph "cluster_Lab31.Storage (only file I/O)" { label="Lab31.Storage (only file I/O)"; style="rounded,dashed"; color="#888888"; fontsize=12;
"IRecordStorage";
"IRecordReader";
"IRecordWriter";
"TextFileRecordStorage";
"TextRecordReader";
"TextRecordWriter";
}
"IRecordStorage" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#FFF3D6" ALIGN="CENTER" CELLPADDING="4"><FONT POINT-SIZE="9">«interface»</FONT><BR/><B>IRecordStorage</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT POINT-SIZE="10">+Exists : bool<BR ALIGN="LEFT"/>+OpenReader() : IRecordReader<BR ALIGN="LEFT"/>+OpenAppender() : IRecordWriter<BR ALIGN="LEFT"/>+BeginRewrite() : IRecordWriter<BR ALIGN="LEFT"/>+CommitRewrite()<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"IRecordReader" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#FFF3D6" ALIGN="CENTER" CELLPADDING="4"><FONT POINT-SIZE="9">«interface»</FONT><BR/><B>IRecordReader</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT POINT-SIZE="10">+ReadRecordHeader(out type, out name) : bool<BR ALIGN="LEFT"/>+ReadAttribute(out name, out value) : bool<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"IRecordWriter" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#FFF3D6" ALIGN="CENTER" CELLPADDING="4"><FONT POINT-SIZE="9">«interface»</FONT><BR/><B>IRecordWriter</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT POINT-SIZE="10">+BeginRecord(type, name)<BR ALIGN="LEFT"/>+WriteAttribute(name, value)<BR ALIGN="LEFT"/>+EndRecord()<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"TextFileRecordStorage" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#FFF3D6" ALIGN="CENTER" CELLPADDING="4"><B>TextFileRecordStorage</B></TD></TR></TABLE>>];
"TextRecordReader" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#FFF3D6" ALIGN="CENTER" CELLPADDING="4"><B>TextRecordReader</B></TD></TR></TABLE>>];
"TextRecordWriter" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#FFF3D6" ALIGN="CENTER" CELLPADDING="4"><B>TextRecordWriter</B></TD></TR></TABLE>>];
"PersonRepository" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#E6F4EA" ALIGN="CENTER" CELLPADDING="4"><B>PersonRepository</B></TD></TR></TABLE>>];
"IPersonRepository" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#E6F4EA" ALIGN="CENTER" CELLPADDING="4"><FONT POINT-SIZE="9">«interface»</FONT><BR/><B>IPersonRepository</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT POINT-SIZE="10">+Add(Person)<BR ALIGN="LEFT"/>+Find(Predicate) : Person[]<BR ALIGN="LEFT"/>+Remove(Predicate) : int<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"IPersonService" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#E6F4EA" ALIGN="CENTER" CELLPADDING="4"><FONT POINT-SIZE="9">«interface»</FONT><BR/><B>IPersonService</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT POINT-SIZE="10">+Add(descriptor, values) : Person<BR ALIGN="LEFT"/>+GetAll() : Person[]<BR ALIGN="LEFT"/>+FindByLastName(string) : Person[]<BR ALIGN="LEFT"/>+FindById(string) : Person<BR ALIGN="LEFT"/>+DeleteById(string) : int<BR ALIGN="LEFT"/>+FindStudents(course, country) : Student[]<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"PersonService" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#E6F4EA" ALIGN="CENTER" CELLPADDING="4"><B>PersonService</B></TD></TR></TABLE>>];
"ConsoleMenu" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#E8EEF9" ALIGN="CENTER" CELLPADDING="4"><B>ConsoleMenu</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT POINT-SIZE="10">+Run()<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"IDemoDataProvider" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#E8EEF9" ALIGN="CENTER" CELLPADDING="4"><FONT POINT-SIZE="9">«interface»</FONT><BR/><B>IDemoDataProvider</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT POINT-SIZE="10">+GetRecords() : DemoRecord[]<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"DemoDataProvider" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#E8EEF9" ALIGN="CENTER" CELLPADDING="4"><B>DemoDataProvider</B></TD></TR></TABLE>>];
"IPersonTypeRegistry" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#F3E8F9" ALIGN="CENTER" CELLPADDING="4"><FONT POINT-SIZE="9">«interface»</FONT><BR/><B>IPersonTypeRegistry</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT POINT-SIZE="10">+Count : int<BR ALIGN="LEFT"/>+FindByTypeName(string) : IPersonDescriptor<BR ALIGN="LEFT"/>+GetFor(Person) : IPersonDescriptor<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"PersonTypeRegistry" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#F3E8F9" ALIGN="CENTER" CELLPADDING="4"><B>PersonTypeRegistry</B></TD></TR></TABLE>>];
"IPersonDescriptor" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#F3E8F9" ALIGN="CENTER" CELLPADDING="4"><FONT POINT-SIZE="9">«interface»</FONT><BR/><B>IPersonDescriptor</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT POINT-SIZE="10">+TypeName : string<BR ALIGN="LEFT"/>+Attributes : AttributeSpec[]<BR ALIGN="LEFT"/>+Describes(Person) : bool<BR ALIGN="LEFT"/>+Create(string[]) : Person<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"PersonDescriptor" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#F3E8F9" ALIGN="CENTER" CELLPADDING="4"><B><I>PersonDescriptor&lt;T&gt;</I></B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT POINT-SIZE="10">#CreateTyped(string[]) : T<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"StudentDescriptor" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#F3E8F9" ALIGN="CENTER" CELLPADDING="4"><B>StudentDescriptor</B></TD></TR></TABLE>>];
"McdonaldsWorkerDescriptor" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#F3E8F9" ALIGN="CENTER" CELLPADDING="4"><B>McdonaldsWorkerDescriptor</B></TD></TR></TABLE>>];
"ManagerDescriptor" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#F3E8F9" ALIGN="CENTER" CELLPADDING="4"><B>ManagerDescriptor</B></TD></TR></TABLE>>];
"AttributeSpec" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#F3E8F9" ALIGN="CENTER" CELLPADDING="4"><B>AttributeSpec</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT POINT-SIZE="10">+Name : string<BR ALIGN="LEFT"/>+Label : string<BR ALIGN="LEFT"/>+IsRequired : bool<BR ALIGN="LEFT"/>+Validate(string) : string<BR ALIGN="LEFT"/>+Normalize(string) : string<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"Person" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#E8EEF9" ALIGN="CENTER" CELLPADDING="4"><B><I>Person</I></B></TD></TR></TABLE>>];
"IPersonAction" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#E8EEF9" ALIGN="CENTER" CELLPADDING="4"><FONT POINT-SIZE="9">«interface»</FONT><BR/><B>IPersonAction</B></TD></TR></TABLE>>];
"TextFileRecordStorage" -> "IRecordStorage" [arrowhead=empty, style=dashed];
"TextRecordReader" -> "IRecordReader" [arrowhead=empty, style=dashed];
"TextRecordWriter" -> "IRecordWriter" [arrowhead=empty, style=dashed];
"IRecordStorage" -> "IRecordReader" [arrowhead=vee, style=dashed, label="creates", fontsize=9];
"IRecordStorage" -> "IRecordWriter" [arrowhead=vee, style=dashed, label="creates", fontsize=9];
"PersonRepository" -> "IPersonRepository" [arrowhead=empty, style=dashed];
"PersonService" -> "IPersonService" [arrowhead=empty, style=dashed];
"PersonService" -> "IPersonRepository" [arrowhead=vee];
"PersonRepository" -> "IRecordStorage" [arrowhead=vee];
"PersonRepository" -> "IPersonTypeRegistry" [arrowhead=vee];
"ConsoleMenu" -> "IPersonService" [arrowhead=vee];
"ConsoleMenu" -> "IPersonTypeRegistry" [arrowhead=vee];
"ConsoleMenu" -> "IPersonAction" [arrowhead=vee];
"ConsoleMenu" -> "IDemoDataProvider" [arrowhead=vee];
"DemoDataProvider" -> "IDemoDataProvider" [arrowhead=empty, style=dashed];
"PersonTypeRegistry" -> "IPersonTypeRegistry" [arrowhead=empty, style=dashed];
"PersonTypeRegistry" -> "IPersonDescriptor" [dir=both, arrowtail=odiamond, arrowhead=none, label="0..*", fontsize=9];
"PersonDescriptor" -> "IPersonDescriptor" [arrowhead=empty, style=dashed];
"StudentDescriptor" -> "PersonDescriptor" [arrowhead=empty];
"McdonaldsWorkerDescriptor" -> "PersonDescriptor" [arrowhead=empty];
"ManagerDescriptor" -> "PersonDescriptor" [arrowhead=empty];
"IPersonDescriptor" -> "AttributeSpec" [dir=both, arrowtail=diamond, arrowhead=none, label="1..*", fontsize=9];
"IPersonDescriptor" -> "Person" [arrowhead=vee, style=dashed, label="creates", fontsize=9];
}